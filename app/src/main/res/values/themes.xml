<resources>
    <style name="Theme.MicroBoy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/microboy_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.MicroBoy.Game" parent="Theme.MicroBoy">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <color name="microboy_bg">#FF14121F</color>
    <color name="ic_bg">#FF1E1B2E</color>
</resources>
